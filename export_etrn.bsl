// ============================================================================
// Назначение: Тихая фоновая выгрузка трех таблиц («Модель расчетов.xlsx»,
// «ЭТРН 1с.xlsx» и «Процент.xlsx») из базы 1С без диалоговых окон.
//
// Запуск из командной строки / Python (FastAPI / server.py):
// "C:\Program Files\1cv8\8.3.xx\bin\1cv8c.exe" ENTERPRISE ^
//   /IBConnectionString "<СтрокаПодключения>" ^
//   /Execute "C:\Path\To\export_etrn.epf" ^
//   /C "03.11.2026;05.11.2026;C:\Users\s.khvostov\Desktop"
// ============================================================================

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    // Предотвращаем зависание открытого окна формы
    Отказ = Истина;
    
    Попытка
        ВыполнитьФоновуюВыгрузку();
    Исключение
        ЗаписьЖурналаРегистрации(
            "ВыгрузкаЭТРН",
            УровеньЖурналаРегистрации.Ошибка,,,
            ОписаниеОшибки()
        );
    КонецПопытки;
    
    // Безусловное завершение работы 1С после выполнения выгрузки
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьФоновуюВыгрузку()
    ПараметрыСтрока = СокрЛП(ПараметрЗапуска);
    
    // Значения по умолчанию
    ДатаНачала = НачалоДня(ТекущаяДата() - 86400);
    ДатаОкончания = КонецДня(ТекущаяДата() - 86400);
    КаталогВыгрузки = КаталогВременныхФайлов();
    
    Если Не ПустаяСтрока(ПараметрыСтрока) Тогда
        МассивПараметров = СтрРазделить(ПараметрыСтрока, ";");
        Если МассивПараметров.Количество() >= 1 Тогда
            ДатаНачала = Дата(СтрЗаменить(МассивПараметров[0], ".", ""));
        КонецЕсли;
        Если МассивПараметров.Количество() >= 2 Тогда
            ДатаОкончания = КонецДня(Дата(СтрЗаменить(МассивПараметров[1], ".", "")));
        Иначе
            ДатаОкончания = КонецДня(ДатаНачала);
        КонецЕсли;
        Если МассивПараметров.Количество() >= 3 Тогда
            КаталогВыгрузки = МассивПараметров[2];
        КонецЕсли;
    КонецЕсли;
    
    // Период для Маршрутных листов (30 дней назад от даты окончания)
    ДатаНачалаМЛ = НачалоДня(ДатаОкончания - 30 * 86400);
    
    // 1. Выгрузка «Модель расчетов.xlsx» (Документ.МаршрутныйЛист)
    ПутьМодель = КаталогВыгрузки + ?(Прав(КаталогВыгрузки, 1) = "\", "", "\") + "Модель расчетов.xlsx";
    ВыгрузитьМаршрутныеЛистыНаСервере(ДатаНачалаМЛ, ДатаОкончания, ПутьМодель);
    
    // 2. Выгрузка «ЭТРН 1с.xlsx» (Документ.ЭлектроннаяТранспортнаяНакладная)
    ПутьЭТРН = КаталогВыгрузки + ?(Прав(КаталогВыгрузки, 1) = "\", "", "\") + "ЭТРН 1с.xlsx";
    ВыгрузитьЭТРННаСервере(ДатаНачала, ДатаОкончания, ПутьЭТРН);
    
    // 3. Выгрузка «Процент.xlsx» (Отчет «Контроль подписания перевозчиков по ЭТРН»)
    ПутьПроцент = КаталогВыгрузки + ?(Прав(КаталогВыгрузки, 1) = "\", "", "\") + "Процент.xlsx";
    СформироватьОтчетПроцентНаСервере(ДатаНачала, ДатаОкончания, ПутьПроцент);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыгрузитьМаршрутныеЛистыНаСервере(ДатаС, ДатаПо, ПутьКФайлу)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	МЛ.Номер КАК Номер,
        |	МЛ.Водитель.Наименование КАК Водитель,
        |	МЛ.Перевозчик.Наименование КАК Перевозчик,
        |	МЛ.МодельРасчетов.Наименование КАК МодельРасчетов
        |ИЗ
        |	Документ.МаршрутныйЛист КАК МЛ
        |ГДЕ
        |	МЛ.ДатаОтгрузки МЕЖДУ &ДатаС И &ДатаПо
        |	И МЛ.ПометкаУдаления = ЛОЖЬ";
    Запрос.УстановитьПараметр("ДатаС", ДатаС);
    Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
    
    ТЗ = Запрос.Выполнить().Выгрузить();
    
    // Запись в ТабличныйДокумент и сохранение в Excel
    ТабДок = Новый ТабличныйДокумент;
    // Построение колонок
    Для Каждого Колонка Из ТЗ.Колонки Цикл
        ТабДок.Область(1, ТЗ.Колонки.Индекс(Колонка) + 1).Текст = Колонка.Имя;
    КонецЦикла;
    
    НомерСтроки = 2;
    Для Каждого Стр Из ТЗ Цикл
        Для ИндексКол = 0 По ТЗ.Колонки.Количество() - 1 Цикл
            ТабДок.Область(НомерСтроки, ИндексКол + 1).Текст = Строка(Стр[ИндексКол]);
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    
    ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
КонецПроцедуры

&НаСервереБезКонтекста
