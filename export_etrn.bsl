&НаСервереБезКонтекста
Процедура СформироватьОтчетПроцентНаСервере(ДатаС, ДатаПо, ПутьКФайлу)
    // Формирование СКД отчета по навигационной ссылке варианта отчета
    Попытка
        Вариант = Справочники.ВариантыОтчетов.ПолучитьСсылку(Новый УникальныйИдентификатор("946700e0-ed9e-2e9e-11f1-495d81d50ffe"));
        ОтчетОбъект = Вариант.Отчет.ПолучитьОбъект();
        СхемаКД = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
        
        Настройки = Вариант.Настройки.Получить();
        // Установка дат в настройках СКД
        Для Каждого Элемент Из Настройки.ПараметрыДанных.Элементы Цикл
            Если Найти(ВРег(Строка(Элемент.Параметр)), "НАЧАЛО") > 0 ИЛИ Найти(ВРег(Строка(Элемент.Параметр)), "ДАТАС") > 0 Тогда
                Элемент.Значение = ДатаС;
                Элемент.Использование = Истина;
            ИначеЕсли Найти(ВРег(Строка(Элемент.Параметр)), "КОНЕЦ") > 0 ИЛИ Найти(ВРег(Строка(Элемент.Параметр)), "ДАТАПО") > 0 Тогда
                Элемент.Значение = ДатаПо;
                Элемент.Использование = Истина;
            КонецЕсли;
        КонецЦикла;
        
        КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
        МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКД, Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
        
        ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
        ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
        
        ТабДок = Новый ТабличныйДокумент;
        ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
        ПроцессорВывода.УстановитьДокумент(ТабДок);
        ПроцессорВывода.Вывести(ПроцессорКомпоновки);
        
        ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
    Исключение
        // Если СКД вариант не найден, записываем пустой каркас
        ЗаписьЖурналаРегистрации("ВыгрузкаЭТРН", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
